# HTML head tag items
VITE_APP_TITLE=RFS Data Store
VITE_APP_DESCRIPTION=Browse, subset and download GEOGLOWS River Forecast System hydrography, retrospective and forecast datasets

# Logo and URL Refs (width height are image native size to get aspect ratios right, not how it is transformed by the app)
VITE_LOGO_SRC=https://cdn.apps.geoglows.org/static/images/geoglows-logo-nav.webp
VITE_LOGO_HREF=/
VITE_LOGO_ALT=GEOGLOWS
VITE_LOGO_WIDTH=354
VITE_LOGO_HEIGHT=60

# Default map camera for the area of interest picker
VITE_MAP_CENTER_LON=0
VITE_MAP_CENTER_LAT=20
VITE_MAP_ZOOM=1.5

# Default theme: [light, dark]
VITE_PREFERENCES_DEFAULT_THEME=dark

# Where the "download it yourself" commands point. The https root is what the browser reads through
# riverforecastsystem; the s3 root is the same tree as a bucket prefix for s5cmd / awscli.
# TODO: confirm the final public bucket prefix for v3.
VITE_S3_V3_ROOT=s3://river-forecast-system/v3
VITE_S3_V2_ROOT=s3://geoglows-v2
VITE_S3_V2_FORECASTS_ROOT=s3://geoglows-v2-forecasts
VITE_S3_V1_ROOT=s3://river-forecast-system/v1

# Largest request the browser will assemble itself, in MB. Anything bigger is pointed at the CLI.
VITE_MAX_BROWSER_MB=500

# User accounts (@geoglows/geoglows-auth). Unused while src/account/auth.js is the dummy.
VITE_PORTAL_URL=https://apps.geoglows.org
