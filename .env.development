# Loaded only by dev but not production builds. ./data is served by vite.config.js when it exists.
# The sample CDN has one synthetic forecast, 2026-07-10, which the forecast form opens on in dev.
# Leave empty to read the public CDN sample data.
VITE_RFS_V3_BASE=
VITE_FORECAST_DEFAULT_DATE=2026-07-10
